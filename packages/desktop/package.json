{
  "name": "stretch4paws-app",
  "version": "1.0.0",
  "description": "",
  "license": "ISC",
  "author": "",
  "type": "commonjs",
  "main": "dist/main.js",
  "scripts": {
    "test": "echo \"Error: no test specified\" && exit 1",
    "start": "electron .",
    "dev:electron": "tsc -w",
    "dev:react": "pnpm --prefix renderer dev",
    "dev": "concurrently \"npm:dev:react\" \"npm:dev:electron\" \"wait-on http://localhost:5173 && electron .\"",
    "build:renderer": "pnpm --prefix renderer build",
    "build:main": "tsc",
    "build": "pnpm run build:renderer && pnpm run build:main",
    "sign:dev": "codesign --force --deep --sign 'Stretch4Paws App' --timestamp=none build/mac-arm64/Stretch4Paws.app",
    "dist:mac": "pnpm run build && electron-builder --mac",
    "dist:mac:signed": "pnpm run dist:mac && pnpm run sign:dev",
    "dist:win": "pnpm run build && electron-builder --win"
  },
  "devDependencies": {
    "@types/node": "^22.0.0",
    "concurrently": "^10.0.3",
    "electron": "^42.5.1",
    "electron-builder": "^26.15.3",
    "sass-embedded": "^1.100.0",
    "typescript": "^6.0.3",
    "wait-on": "^9.0.10"
  },
  "dependencies": {
    "@stretch4paws/core": "workspace:*",
    "dotenv": "^17.4.2"
  }
}

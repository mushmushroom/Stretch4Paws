# Supabase project URL — found in Supabase dashboard → Project Settings → API
VITE_SUPABASE_URL=https://your-project.supabase.co

# Supabase anon/public key — found in Supabase dashboard → Project Settings → API
VITE_SUPABASE_ANON_KEY=your-anon-key

# URL of the web app (used to open auth/dashboard links in the browser)
# In production, set this to your deployed web app URL e.g. https://stretch4paws.com
VITE_PUBLIC_URL=http://localhost:5173

# URL for the Vite dev server (used in dev mode)
DEV_URL=http://localhost:5173

# URL of the web app (used for auth window and open-external origin check)
# In production, set this to your deployed web app URL e.g. https://stretch4paws.com
APP_URL=http://localhost:5173

# Enable debug logging in the main process (true | false)
DEBUG=false

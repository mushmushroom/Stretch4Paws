# Supabase project URL — found in Supabase dashboard → Project Settings → API
VITE_SUPABASE_URL=https://your-project.supabase.co

# Supabase anon/public key — found in Supabase dashboard → Project Settings → API
VITE_SUPABASE_ANON_KEY=your-anon-key

# Public URL of this web app (used for redirects and desktop app integration)
# In production, set this to your deployed URL e.g. https://stretch4paws.com
VITE_PUBLIC_URL=http://localhost:5173
